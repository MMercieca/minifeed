<h1 class="font-semibold text-4xl text-slate-600">Getting Started</h1>
<section class="w-full flex flex-row mt-10">
  <div class="flex p-2">  
    <div class="shadow p-2 text-slate-500">
      <p><span class="bg-dark-orange text-white circle-number">
        <i class="fa-solid fa-1"></i>
      </span>
      Use your Google or Patreon account to sign up or sign in to the app.</p>
      <%= link_to "Sign Up with Google", user_google_oauth2_omniauth_authorize_path, style: "color: white; min-width: 220px;display: inline-block;text-decoration: none", class: "card w-1/4 text-center bg-light-blue text-sm uppercase text-white font-bold py-2 px-4" %>
      <br />
      <br />
      <%= link_to "Sign Up with Patreon", "/patreon_launch", style: "color: white; min-width: 220px;display: inline-block; text-decoration: none", class: "card w-1/4 text-center bg-dark-orange text-sm uppercase text-white font-bold py-2 px-4" %>
      <img src="/img/getting-started-spacer.png" />
    </div>
  </div>
</section>
<section class="w-full flex flex-row mt-10">
  <div class="flex p-2">
    <div class="shadow p-2 text-slate-500">
      <p><span class="bg-dark-orange text-white circle-number">
        <i class="fa-solid fa-2"></i>
      </span>
      Add the podcast you want to split up or filter to your dashboard.</p>
      <img src="/img/add-podcast.png" alt="A screenshot of Minicast where the user is prompted to add a podcast by entering a name and an RSS URL for it." />
    </div>
  </div>
</section>
<section class="w-full flex flex-row mt-10">
  <div class="flex p-2">
    <div class="shadow p-2 text-slate-500">
      <p><span class="bg-dark-orange text-white circle-number">
        <i class="fa-solid fa-3"></i>
      </span>
      Filter the podcast how you want.</p>
      <img src="/img/filter-podcast.png" alt="A screenshot of Minicast where the user is prompted to create a split feed of the podcast entered in step 2." />
    </div>
  </div>
</section>
<section class="w-full flex flex-row mt-10">
  <div class="flex p-2">
    <div class="shadow p-2 text-slate-500">
      <p><span class="bg-dark-orange text-white circle-number">
        <i class="fa-solid fa-4"></i>
      </span>
      Add the filtered URL to your podcast player and enjoy!</p>
      <img src="/img/getting-started-follow-by-url.png" class="mr-28 mb-28" style="float: left" alt="A screenshot of Apple Podcasts library menu exposed by selecting the three dots on the library page.  The option to 'Follow a Show by URL' is available at the top." />
      <img src="/img/getting-started-add-podcast.png" style="float: left" alt="A screenshot of Apple Podcasts showing the 'Add Podcast / Follow a Show by URL' menu." />
      
      <img src="/img/getting-started-spacer.png" />
    </div>
  </div>
  
</sction>

