<section class="header relative items-center flex flex-row">
  <div class="container mx-auto items-center flex">
    <div class="w-3/4 md:w-full sm:w-full px-4">
      <div class="mr-8 sm:pt-0">
        <h1 class="font-semibold text-4xl text-slate-600">An intelligent podcast splitter</h1>
        <p class="leading-relaxed text-slate-500">
          Take one podcast with multiple series and split it into mini-feeds, one feed for each series, and load them into your podcast player of choice.
        </p>
      </div>
    </div>
    <div class="h-full align-center justify-center items-center pt-4">
      <img class="" alt="Podcast logo" src="/img/podcast.svg" style="height: 300px;"/>
    </div>
  </div>
</section>
<div class="ml-4">
  <a class="text-white font-bold px-6 py-4 mr-1 mb-1 bg-orange uppercase text-sm shadow hover:shadow-lg ease-linear transition-all duration-150" style="color: white; text-decoration: none" href="/getting-started">Get started</a>
</div>

<section class="header relative items-center flex flex-row mt-16">
  <div class="container mx-auto items-center flex">
    <div class="w-full md:w-full sm:w-full px-4">
      <div class="mr-8 sm:pt-0">
        <p class="leading-relaxed text-slate-500">Want to catch up on the Mighty Nein before their cartoon airs on Amazon? <a href="/critical-role">Split up the Critical Role feed by title</a>.</p>
        <p class="leading-relaxed text-slate-500">Want to relisten to the Balance arc of The Adventure Zone? <a href="/adventure-zone">Split up the feed by iTunes season</a>.</p>
        <p class="leading-relaxed text-slate-500">Emojis crashing your Android Auto car? <a href="/android-auto">Load all the episodes with Android Auto compatibility</a>.</p>
    
      </div>
    </div>
  </div>
</section>
<% if false %>
